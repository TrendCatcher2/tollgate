# Braintree sandbox (a PayPal service): sandbox.braintreegateway.com -> gear icon -> API -> Keys
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# Optional: PayPal REST sandbox app credentials, for the PayPal Agent Toolkit adapter
# Developer Dashboard -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; defaults to gemma-4-31b-it. Gemini 3.x models need thought signatures this SDK version does not send.
GEMINI_MODEL=
