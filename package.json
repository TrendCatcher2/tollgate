{
  "name": "tollgate",
  "version": "0.1.0",
  "private": true,
  "description": "A policy firewall for AI agents that use the PayPal Agent Toolkit",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "eval:gemini": "tsx scripts/eval.ts --model gemini",
    "smoke:braintree": "tsx scripts/smoke-braintree.ts",
    "seed:braintree": "tsx scripts/seed-braintree.ts",
    "start": "tsx scripts/serve.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "1.2.22",
    "@paypal/agent-toolkit": "1.11.0",
    "ai": "4.3.19",
    "braintree": "3.40.0",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/braintree": "3.4.5",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
